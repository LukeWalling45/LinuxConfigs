  "scripts": {
    "build-docker-image": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker build --tag davidanson/markdownlint-cli2:v$VERSION --file docker/Dockerfile --label org.opencontainers.image.version=v$VERSION .",
    "build-docker-image-rules": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker build --tag davidanson/markdownlint-cli2-rules:v$VERSION --file docker/Dockerfile-rules --build-arg VERSION=v$VERSION --label org.opencontainers.image.version=v$VERSION .",
    "ci": "concurrently npm:test npm:lint npm:schema && git diff --exit-code && echo PASS",
    "lint": "eslint --max-warnings 0",
    "lint-dockerfile": "docker run --rm --interactive hadolint/hadolint:latest-alpine < docker/Dockerfile",
    "lint-watch": "git ls-files | entr npm run lint",
    "playwright-install-bare": "npm run playwright-install-npm && playwright install",
    "playwright-install-npm": "npm install --no-save playwright@1.64.1",
    "playwright-test": "playwright test --config ./webworker/playwright.config.mjs",
    "playwright-test-docker": "docker run --rm --volume $PWD:/home/workdir --workdir /home/workdir --ipc=host mcr.microsoft.com/playwright:v1.64.1 npm run playwright-test",
    "schema": "cpy ./node_modules/markdownlint/schema/markdownlint-config-schema.json ./schema --flat",
    "test": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 --test-coverage-exclude=test/**/{*,.*} test/append-to-array-test.mjs test/clone-options-test.mjs test/constants-test.mjs test/deep-freeze-test.mjs test/fs-virtual-test.mjs test/markdownlint-cli2-test.mjs test/markdownlint-cli2-test-cli.mjs test/markdownlint-cli2-test-exec-*.mjs test/markdownlint-cli2-test-exports.mjs test/markdownlint-cli2-test-formatters.mjs test/markdownlint-cli2-test-fs.mjs test/merge-options-test.mjs",
    "test-docker-hub-image": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker image rm davidanson/markdownlint-cli2:v$VERSION davidanson/markdownlint-cli2:latest || true && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2:v$VERSION \"*.md\" && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2:latest \"*.md\"",
    "test-docker-hub-image-rules": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker image rm davidanson/markdownlint-cli2-rules:v$VERSION davidanson/markdownlint-cli2-rules:latest || true && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2-rules:v$VERSION \"*.md\" && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2-rules:latest \"*.md\"",
    "test-docker-image": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2:v$VERSION \"*.md\"",
    "test-docker-image-rules": "VERSION=$(node -e \"process.stdout.write(require('./package.json').version)\") && docker run --rm --volume $PWD:/workdir davidanson/markdownlint-cli2-rules:v$VERSION \"*.md\"",
    "test-watch": "git ls-files | entr npm run test",
    "update-snapshots": "node --test --test-update-snapshots test/markdownlint-cli2-test-exec-*.mjs test/markdownlint-cli2-test-exports.mjs test/markdownlint-cli2-test-formatters.mjs test/markdownlint-cli2-test-fs.mjs",
    "webworker": "cd webworker && webpack --mode none",
    "webworker-install": "npm install --no-save @ljharb/tsconfig path-browserify setimmediate stream-browserify util webpack-cli && cpy ./node_modules/setimmediate/setImmediate.js ./webworker --flat --rename=setImmediate.cjs"
